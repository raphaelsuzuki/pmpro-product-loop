{
  "name": "pmpro/pmpro-product-loop",
  "description": "PMPro Product Loop bridge plugin for WooCommerce and PMPro Magic Levels",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "PMProProductLoop\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PMProProductLoop\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs"
  }
}
